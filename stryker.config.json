{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Mutation testing of safety-critical code (ADR-006): mutation score of at least 80% (owner, 2026-11-10). 'mutate' lists only the safety-critical units, so the selection is by critical path. Incremental mode is off: on 2026-11-12 it reused stale results and reported 90.85% where a full run gave 96.48%.",
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts"
  },
  "checkers": ["typescript"],
  "tsconfigFile": "tsconfig.json",
  "mutate": [
    "packages/core/src/**/*.ts",
    "!packages/core/src/index.ts",
    "packages/synth/src/fda.ts",
    "packages/synth/src/snapshot.ts",
    "packages/synth/src/data-checks.ts"
  ],
  "coverageAnalysis": "perTest",
  "thresholds": {
    "high": 80,
    "low": 80,
    "break": 80
  },
  "incremental": false,
  "reporters": ["clear-text", "progress", "html", "json"],
  "htmlReporter": {
    "fileName": "reports/mutation/mutation.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "tempDirName": ".stryker-tmp",
  "plugins": [
    "@stryker-mutator/vitest-runner",
    "@stryker-mutator/typescript-checker"
  ]
}
